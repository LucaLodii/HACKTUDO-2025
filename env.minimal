# Minimal .env file for sofIA development
# Copy this to .env and add your actual values

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Google API Key for Gemini AI (REQUIRED)
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Supabase Configuration (REQUIRED for subscription management)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key-here

# =============================================================================
# BASIC SETTINGS
# =============================================================================

# Environment
ENVIRONMENT=development
DEBUG=true

# WhatsApp Bridge (Node.js service)
WHATSAPP_BRIDGE_URL=http://localhost:3001

# Application
HOST=0.0.0.0
PORT=8000

# =============================================================================
# SUBSCRIPTION MANAGEMENT
# =============================================================================

# Enable subscription features
ENABLE_PROACTIVE_REMINDERS=true
AUTO_SCHEDULE_RENEWALS=true

# Business settings
DEFAULT_CURRENCY=BRL
DEFAULT_TIMEZONE=America/Sao_Paulo
DEFAULT_LANGUAGE=pt-BR

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# BEMOBI Integration (only if using real BEMOBI API)
# BEMOBI_API_KEY=your-bemobi-api-key
# BEMOBI_SECRET_KEY=your-bemobi-secret-key

# WhatsApp Business API (only if using official API)
# WHATSAPP_ACCESS_TOKEN=your-access-token
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
