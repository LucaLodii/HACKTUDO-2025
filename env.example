# sofIA WhatsApp Payment Agent Configuration
# Copy this file to .env and fill in your actual values

# Google AI Configuration (for Gemini 2.5 Flash model used by sofIA agent)
GOOGLE_API_KEY=your_google_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# AP2 Protocol Configuration
AGENT_ID=sofia-whatsapp-agent
MERCHANT_ID=sofia-merchant

# Security Configuration (if needed for production)
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here

# Supabase Configuration (for persistent memory storage)
SUPABASE_URL=https://nknnxwqhpsgfiivnilmy.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5rbm54d3FocHNnZmlpdm5pbG15Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTg5ODIyNDcsImV4cCI6MjA3NDU1ODI0N30.D6cjrObxE_-0hhXjW_AbPKXUkMZi5EIgfJXigLz0_V0

# BEMOBI Configuration (for payment gateway integration)
BEMOBI_ENABLED=true
BEMOBI_MOCK_MODE=true
BEMOBI_API_KEY=your_bemobi_api_key_here
BEMOBI_SECRET_KEY=your_bemobi_secret_key_here
BEMOBI_BASE_URL=https://api.bemobi.com/v1
BEMOBI_REGION=latam
BEMOBI_MOCK_DELAY=0.5
BEMOBI_MOCK_FAILURE_RATE=0.05

# Database Configuration (if using persistent storage)
DATABASE_URL=sqlite:///./sofia_payments.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=sofia_payments.log
