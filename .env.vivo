# VIVO White-label Environment Configuration
# This configuration makes sofIA work exclusively for VIVO customers

# Google API Key (required)
GOOGLE_API_KEY=your_google_api_key_here

# VIVO Operator Configuration
OPERATOR_NAME=VIVO
OPERATOR_DISPLAY_NAME=Vivo
OPERATOR_ID=11111111-1111-1111-1111-111111111111

# VIVO Branding
BRAND_COLOR=#8B2797
BRAND_LOGO_URL=https://upload.wikimedia.org/wikipedia/commons/thumb/e/e2/Vivo_logo.svg/200px-Vivo_logo.svg.png

# VIVO Bemobi Mock Credentials
BEMOBI_USE_MOCK=true
BEMOBI_MERCHANT_ID=MOCK_VIVO_MERCHANT_001
BEMOBI_API_KEY=mock_vivo_api_key_123456789
BEMOBI_SECRET_KEY=mock_vivo_secret_987654321

# VIVO sofIA Agent Configuration
SOFIA_AGENT_ID=sofia-vivo-agent
SOFIA_AGENT_NAME=sofIA VIVO Payment Agent

# VIVO Payment Methods
SUPPORTED_PAYMENT_METHODS=["PIX", "CARD", "BOLETO", "VIVO_WALLET"]

# Server Configuration
HOST=0.0.0.0
PORT=8000

# WhatsApp Configuration (VIVO's WhatsApp number)
WHATSAPP_PHONE_NUMBER=+55119999VIVO
WHATSAPP_BUSINESS_NAME=VIVO sofIA

# Mock Configuration
MOCK_SUCCESS_RATE=0.97
MOCK_PROCESSING_DELAY_MS=1500