# OI White-label Environment Configuration
# This configuration makes sofIA work exclusively for OI customers

# Google API Key (required)
GOOGLE_API_KEY=your_google_api_key_here

# OI Operator Configuration
OPERATOR_NAME=OI
OPERATOR_DISPLAY_NAME=Oi
OPERATOR_ID=33333333-3333-3333-3333-333333333333

# OI Branding
BRAND_COLOR=#F9B233
BRAND_LOGO_URL=https://upload.wikimedia.org/wikipedia/commons/thumb/3/36/Oi_logo.svg/200px-Oi_logo.svg.png

# OI Bemobi Mock Credentials
BEMOBI_USE_MOCK=true
BEMOBI_MERCHANT_ID=MOCK_OI_MERCHANT_003
BEMOBI_API_KEY=mock_oi_api_key_123abc456
BEMOBI_SECRET_KEY=mock_oi_secret_789fed654

# OI sofIA Agent Configuration
SOFIA_AGENT_ID=sofia-oi-agent
SOFIA_AGENT_NAME=sofIA OI Payment Agent

# OI Payment Methods
SUPPORTED_PAYMENT_METHODS=["PIX", "CARD", "BOLETO", "OI_MONEY"]

# Server Configuration
HOST=0.0.0.0
PORT=8002

# WhatsApp Configuration (OI's WhatsApp number)
WHATSAPP_PHONE_NUMBER=+55119999OI
WHATSAPP_BUSINESS_NAME=OI sofIA

# Mock Configuration
MOCK_SUCCESS_RATE=0.92
MOCK_PROCESSING_DELAY_MS=2500