# =============================================================================
# CONFIGURAÇÃO DE DEPLOY - MERCADO PAGO SANDBOX
# =============================================================================
# Copie este arquivo para .env e configure com suas credenciais reais

# =============================================================================
# CONFIGURAÇÕES OBRIGATÓRIAS
# =============================================================================

# Google AI (obrigatório - obtenha em https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=AIzaSyC_sua_chave_google_ai_aqui

# Mercado Pago Sandbox (obrigatório - obtenha em https://www.mercadopago.com.br/developers)
MERCADOPAGO_ACCESS_TOKEN=TEST-sua_access_token_sandbox_aqui
MERCADOPAGO_PUBLIC_KEY=TEST-sua_public_key_sandbox_aqui
MERCADOPAGO_CLIENT_ID=seu_client_id_sandbox_aqui
MERCADOPAGO_CLIENT_SECRET=seu_client_secret_sandbox_aqui

# Ambiente Mercado Pago (IMPORTANTE: use sandbox para testes)
MERCADOPAGO_ENVIRONMENT=sandbox
MERCADOPAGO_USE_MOCK=false

# URL do webhook (substitua pela sua URL de deploy)
MERCADOPAGO_WEBHOOK_URL=https://seu-projeto.onrender.com/webhooks/mercadopago

# =============================================================================
# CONFIGURAÇÕES DO SERVIDOR
# =============================================================================

# Configurações básicas
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
DEBUG=false

# WhatsApp Bridge (se usando bridge separado)
WHATSAPP_BRIDGE_URL=http://localhost:3001

# =============================================================================
# CONFIGURAÇÕES AP2 PROTOCOL
# =============================================================================

# Identificadores do agente
AGENT_ID=sofia-whatsapp-agent
MERCHANT_ID=sofia-merchant

# =============================================================================
# CONFIGURAÇÕES DE NEGÓCIO
# =============================================================================

# Configurações regionais
DEFAULT_CURRENCY=BRL
DEFAULT_TIMEZONE=America/Sao_Paulo
DEFAULT_LANGUAGE=pt-BR

# =============================================================================
# CONFIGURAÇÕES DE SEGURANÇA
# =============================================================================

# Chaves de segurança (gere chaves únicas para produção)
JWT_SECRET=sua_jwt_secret_aqui_32_caracteres
ENCRYPTION_KEY=sua_encryption_key_aqui_32_caracteres

# =============================================================================
# CONFIGURAÇÕES OPCIONAIS
# =============================================================================

# Supabase (opcional - para gerenciamento de assinaturas)
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_KEY=sua_anon_key_aqui

# BEMOBI Integration (opcional - se usando BEMOBI real)
# BEMOBI_API_KEY=sua_bemobi_api_key
# BEMOBI_SECRET_KEY=sua_bemobi_secret_key

# WhatsApp Business API (opcional - se usando API oficial)
# WHATSAPP_ACCESS_TOKEN=seu_access_token
# WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id

# =============================================================================
# CONFIGURAÇÕES DE MONITORAMENTO
# =============================================================================

# Logs e debug
LOG_LEVEL=INFO
ENABLE_REQUEST_LOGGING=true

# Métricas
ENABLE_METRICS=true
METRICS_PORT=9090

# =============================================================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO
# =============================================================================

# Apenas para desenvolvimento local (NÃO usar em produção)
# MERCADOPAGO_USE_MOCK=true
# DEBUG=true
# ENVIRONMENT=development
