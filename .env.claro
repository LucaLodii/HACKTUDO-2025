# CLARO White-label Environment Configuration
# This configuration makes sofIA work exclusively for CLARO customers

# Google API Key (required)
GOOGLE_API_KEY=your_google_api_key_here

# CLARO Operator Configuration
OPERATOR_NAME=CLARO
OPERATOR_DISPLAY_NAME=Claro
OPERATOR_ID=22222222-2222-2222-2222-222222222222

# CLARO Branding
BRAND_COLOR=#E61E24
BRAND_LOGO_URL=https://upload.wikimedia.org/wikipedia/commons/thumb/0/00/Claro.svg/200px-Claro.svg.png

# CLARO Bemobi Mock Credentials
BEMOBI_USE_MOCK=true
BEMOBI_MERCHANT_ID=MOCK_CLARO_MERCHANT_002
BEMOBI_API_KEY=mock_claro_api_key_abcdef123
BEMOBI_SECRET_KEY=mock_claro_secret_fedcba987

# CLARO sofIA Agent Configuration
SOFIA_AGENT_ID=sofia-claro-agent
SOFIA_AGENT_NAME=sofIA CLARO Payment Agent

# CLARO Payment Methods
SUPPORTED_PAYMENT_METHODS=["PIX", "CARD", "BOLETO", "CLARO_PAY"]

# Server Configuration
HOST=0.0.0.0
PORT=8001

# WhatsApp Configuration (CLARO's WhatsApp number)
WHATSAPP_BUSINESS_NAME=CLARO sofIA

# Mock Configuration
MOCK_SUCCESS_RATE=0.94
MOCK_PROCESSING_DELAY_MS=2200