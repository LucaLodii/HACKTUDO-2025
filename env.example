# sofIA WhatsApp Payment Agent Configuration
# Copy this file to .env and fill in your actual values

# Google AI Configuration (for Gemini 2.5 Flash model used by sofIA agent)
GOOGLE_API_KEY=your_google_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# AP2 Protocol Configuration
AGENT_ID=sofia-whatsapp-agent
MERCHANT_ID=sofia-merchant

# Security Configuration (if needed for production)
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here

# Supabase Configuration (for persistent memory storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Database Configuration (if using persistent storage)
DATABASE_URL=sqlite:///./sofia_payments.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=sofia_payments.log
